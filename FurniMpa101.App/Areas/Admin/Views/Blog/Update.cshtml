@model BlogUpdateVM
<div class="container">
    <div class="row">
        <form method="post">
            <div class="form-group">
                <label for="title">Title</label>
                <input asp-for="Title" class="form-control" id="title" placeholder="Title">
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="text">Text</label>
                <input asp-for="Text" class="form-control" id="text" placeholder="Text">
                <span asp-validation-for="Text" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="emplpoyee">Emplpoyee</label>
                <select asp-for="EmployeeId" class="form-control" id="emplpoyee">
                    <option value="null" disabled selected>Emplpoyee</option>
                    @foreach (var employee in ViewBag.Employees)
                    {
                        <option value="@employee.Id">@employee.FirstName</option>
                    }
                </select>
                <span asp-validation-for="EmployeeId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="tag">Tag</label>
                <select asp-for="TagIds" class="form-control" id="TagsIds">
                    @foreach (var tag in ViewBag.Tags)
                    {
                        <option value="@tag.Id">@tag.Name</option>
                    }
                </select>
                <span asp-validation-for="TagIds" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Submit</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>