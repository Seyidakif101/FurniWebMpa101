@model Blog
<div class="container">
    <div class="row">
        <form method="post">
            <div class="form-group">
                <label for="title">Title</label>
                <input asp-for="Title" class="form-control" id="title" placeholder="Title">
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="text">Text</label>
                <input asp-for="Text" class="form-control" id="text" placeholder="Text">
                <span asp-validation-for="Text" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="employeeId">EmployeeId</label>
                <input asp-for="EmployeeId" class="form-control" id="employeeId" placeholder="EmployeeId">
                <span asp-validation-for="EmployeeId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="imageName">ImageName</label>
                <input asp-for="ImageName" class="form-control" id="imageName" placeholder="ImageName">
                <span asp-validation-for="ImageName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="imageUrl">ImageUrl</label>
                <input asp-for="ImageUrl" class="form-control" id="imageUrl" placeholder="ImageUrl">
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Submit</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>