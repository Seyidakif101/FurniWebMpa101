@model List<Blog>

<div class="container">
    <div class="row">
        <div class="col-2">
            <a class="btn btn-primary mb-3" asp-action="Create">Create</a>
        </div>

        <table class="table table-hover table-dark">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Title</th>
                    <th scope="col">Text</th>
                    <th scope="col">Employee Name</th>
                    <th scope="col">Image</th>
                    <th scope="col">IsDeleted</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var blog in Model)
                {
                    <tr>
                        <td>@blog.Id</td>
                        <td>@blog.Title</td>
                        <td>@blog.Text</td>
                        <td>@blog.Employee?.FirstName</td>
                        <td><img src="~/assets/images/@blog.ImageUrl" width="40" height="40" alt="Alternate Text" /> </td>
                        <td>@blog.IsDeleted</td>
                        <td>
                            <a asp-action="Update" asp-route-id="@blog.Id" class="btn btn-warning">Update</a>
                            <a asp-action="Delete" asp-route-id="@blog.Id" class="btn btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
