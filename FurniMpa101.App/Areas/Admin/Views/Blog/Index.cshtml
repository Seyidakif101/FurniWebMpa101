@model List<Blog>

<div class="container">
    <div class="row">
        <div class="col-2">
            <a class="btn btn-primary mb-3" asp-action="Create">Create</a>
        </div>

        <table class="table table-hover table-dark">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Title</th>
                    <th>Text</th>
                    <th>Employee Name</th>
                    <th>Image Name</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var blog in Model)
                {
                    <tr>
                        <td>@blog.Id</td>
                        <td>@blog.Title</td>
                        <td>@blog.Text</td>
                        <td>@blog.Employee?.FirstName</td>
                        <td>@blog.ImageName</td>
                        <td>
                            <a asp-action="Update" asp-route-id="@blog.Id" class="btn btn-warning">Update</a>
                            <a asp-action="Delete" asp-route-id="@blog.Id" class="btn btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
