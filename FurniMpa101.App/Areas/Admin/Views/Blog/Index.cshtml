@model List<Blog>
<div class="container">
    <div class="row">
        <div class="row">
            <div class="col-2">
                <a class="btn btn-primary mb-3" asp-action="Create">Create</a>

            </div>
        </div>
        <table class="table table-hover table-dark">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Title</th>
                    <th scope="col">Text</th>
                    <th scope="col">EmployeeId</th>
                    <th scope="col">PostedDate</th>
                    <th scope="col">ImageName</th>
                    <th scope="col">ImageUrl</th>
                    <th scope="col">Actions</th>

                </tr>
            </thead>
            <tbody>
                @foreach (Blog blog in Model)
                {
                    <tr>
                        <th scope="row">@blog.Id</th>
                        <td>@blog.Title</td>
                        <td>@blog.Text</td>
                        <td>@blog.EmployeeId</td>
                        <td>@blog.PostedDate</td>
                        <td>@blog.ImageName</td>
                        <td><img src="~/assets/images/website-images/@blog.ImageUrl" width="40" height="40" alt="Alternate Text" /> </td>
                        <td>
                            <a asp-action="Delete" asp-route-id="@blog.Id" class="btn btn-danger">Delete</a>
                            <a class="btn btn-warning">Update</a>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>