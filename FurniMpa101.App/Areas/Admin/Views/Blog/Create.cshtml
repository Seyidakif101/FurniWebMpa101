@using FurniMpa101.App.ViewModels.BlogViewModels
@model BlogCreateVM
<div class="container">
    <div class="row">
        <form method="post" enctype="multipart/form-data">
            <div class="form-group">
                <label for="title">Title</label>
                <input asp-for="Title" class="form-control" id="title" placeholder="Title">
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="text">Text</label>
                <input asp-for="Text" class="form-control" id="text" placeholder="Text">
                <span asp-validation-for="Text" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="emplpoyee">Emplpoyee</label>
                <select asp-for="EmployeeId" class="form-control" id="emplpoyee">
                    <option value="null" disabled selected>Emplpoyee</option>
                    @foreach (var employee in ViewBag.Employees)
                    {
                        <option value="@employee.Id">@employee.FirstName</option>
                    }
                </select>
                <span asp-validation-for="EmployeeId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="Image">Image</label>
                <input asp-for="Image" class="form-control" id="Image" placeholder="Image">
                <span asp-validation-for="Image" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Submit</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>